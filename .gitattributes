# Normalize EOL for all text files Godot reads/writes.
* text=auto eol=lf

*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.import text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf

*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.glb binary
*.res binary
