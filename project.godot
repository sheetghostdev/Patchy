[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="NPC"
3d_physics/layer_5="Interactable"
3d_physics/layer_6="Projectile"
3d_physics/layer_7="Water"
3d_physics/layer_8="GrapplePoint"
3d_physics/layer_9="Trigger"
3d_physics/layer_10="Collectible"
3d_physics/layer_11="Props"
3d_physics/layer_12="PlayerAttack"
3d_physics/layer_13="EnemyAttack"

[physics]

common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
3d/default_gravity=20.0
common/physics_interpolation=true

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.53, 0.8, 0.95, 1)
