[node name="AuntieInk" type="Area3D" parent="Gameplay" unique_id=348414181 node_paths=PackedStringArray("model")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -28.2, 3, 13)
script = ExtResource("28_dqjl2")
display_name = "Auntie Ink"
lines = PackedStringArray("Well, look what the tide dragged in! Sit down, sit down, before you drip on my floor.", "A pirate with no ship? Gus down at the shipyard has an old dinghy gathering barnacles. Ask him nicely.", "And mind the open sea, dear. Swim too far out and you\'ll be fish food. Boats are for that.")
repeat_lines = PackedStringArray("One sea-biscuit, extra soggy? On the house, for a fellow seafarer.", "Tok up the lookout sees everything. Mostly clouds. Sometimes bananas.", "Everyone in Barnacle Bay\'s lost something to Brock\'s crabs. Spoons, mostly. And boats.")
talked_flag = &"castaway_met_ink"
model = NodePath("OctopusModel")

