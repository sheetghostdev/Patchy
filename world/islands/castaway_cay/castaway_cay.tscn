reward_flag = &"castaway_betty_reward"
waiting_lines = PackedStringArray("Those drag marks lead north up the beach. Crabs can\'t have hauled her far... can they?", "If she\'s stuck somewhere high, a few parrot friends could lift her. Three should do it.")
thanks_lines = PackedStringArray("My Betty! Not a scratch on her! ...Well. New scratches.", "Here, my old fishing chart. Some pirate inked an X on the back, years ago. Never did own a shovel.")
after_lines = PackedStringArray("Betty and me, back on the water. Best fishing\'s at dawn, while the crabs are still snoring.", "Your own little boat at the dock floats too... mostly.")
reward_kind = "map"
