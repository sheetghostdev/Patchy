thanks_lines = PackedStringArray("You chased off the pelican! And it coughed up my clam!", "...Huh, there\'s a pearl in it. You keep it, pirate. Pirates love pearls!")
after_lines = PackedStringArray("When I grow up I\'m getting a hook too. Or at least a very pointy spoon.")
